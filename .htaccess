# Portfolio entry — Apache
DirectoryIndex PraveenKMani.html index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pretty URL without .html (serves PraveenKMani.html)
    RewriteRule ^PraveenKMani$ PraveenKMani.html [L]

    # Redirect legacy entry points to main page
    RewriteRule ^index\.html$ PraveenKMani.html [R=301,L]
    RewriteRule ^mpk-portfolio\.html$ PraveenKMani.html [R=301,L]
    RewriteRule ^mpk-portfolio$ PraveenKMani.html [R=301,L]
</IfModule>

<IfModule mod_mime.c>
    AddType text/html .html
</IfModule>
